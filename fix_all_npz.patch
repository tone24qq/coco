+import json
+import subprocess
+from pathlib import Path
+
+
+def test_cli_help() -> None:
+    result = subprocess.run(
+        [
+            "python",
+            "-m",
+            "rf_infer.cli",
+            "--help",
+        ],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    assert "RandomForest board inference" in result.stdout
+
+
+def test_cli_run(tmp_path: Path) -> None:
+    repo_root = Path(__file__).resolve().parent.parent
+    input_path = repo_root / "boards" / "2x2_input.json"
+    models_dir = repo_root / "models"
+    out_file = tmp_path / "out.json"
+
+    subprocess.run(
+        [
+            "python",
+            "-m",
+            "rf_infer.cli",
+            "--input",
+            str(input_path),
+            "--output",
+            str(out_file),
+            "--k",
+            "2",
+            "--models-dir",
+            str(models_dir),
+        ],
+        check=True,
+    )
+
+    data = json.loads(out_file.read_text())
+    assert data[0]["rows"] == 2
+    assert data[0]["target"] == 3
+    assert len(data[0]["predictions"]) > 0
