===== app/main.py =====
from fastapi import FastAPI


app = FastAPI(title="Sample FastAPI App")


def add_numbers(a: int, b: int) -> int:
    return a + b


@app.get("/ping")
async def ping():
    return {"message": "pong"}


@app.get("/add")
async def add(a: int, b: int):
    return {"result": add_numbers(a, b)}

===== End 範例結構參考.txt =====

