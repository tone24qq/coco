[flake8]
max-line-length = 120
extend-ignore = E203,E501,E402,E741
exclude = .git,__pycache__,docs/,build/,dist/

19. Common Pitfalls and Gotchas
-------------------------------
- Mutable Default Arguments:
    def append_to_list(value, lst=[]):
        lst.append(value)
        return lst
  Explanation: Default list is shared across calls.
  Fix: Use None and assign inside:
    def append_to_list(value, lst=None):
        if lst is None:
            lst = []
        lst.append(value)
        return lst


- Shadowing Built-in Names:
    list = [1, 2, 3]
    sum = 0
  Explanation: Overwrites built-in functions.
  Fix: Avoid naming variables after built-ins.


- Misusing is vs. == for equality checks:
    a = 1000
    b = 1000
    print(a is b)  # Might be False
  Fix: Use == for value comparison.


- File Not Closed (Resource Leaks):
    f = open("file.txt")
    data = f.read()
  Fix: Use with statement:
    with open("file.txt") as f:
        data = f.read()


- Logging Misconfigurations:
    logging.basicConfig(format='%(asctime)s %(name)s %(message)s')
  Missing or extra placeholders can cause KeyError in logs.
  Fix: Match placeholders with arguments or use named arguments.


20. Tips to Avoid Errors and Improve Code Quality
-------------------------------------------------
- Use Linters:
    - flake8, pylint, mypy for static type checking.
- Enable Strict Mode:
    - Run Python with -Wall or -Wd to catch warnings.
- Write Unit Tests:
    - Use pytest or unittest to cover code paths.
- Use Integrated Development Environments (IDEs):
    - Save time with auto-completion, real-time error highlighting.
- Follow PEP 8 Style Guide:
    - Maintain consistent formatting to reduce syntax and indentation errors.
- Leverage Type Hints:
    - Write function signatures with hints and validate with mypy.
- Read Official Documentation:
    - Stay updated on language changes and best practices.
- Avoid Overly Complex Expressions:
    - Break down long statements; simplifies debugging.
- Modularize Code:
    - Write small, single-responsibility functions to isolate errors.
- Review Code Regularly:
    - Code reviews help catch mistakes early.


Conclusion:
------------
By understanding these common errors and following the avoidance strategies, you can write more robust and maintainable Python code. Keep this compendium as a reference and update it as you encounter new error patterns.

===== End 除錯.txt =====

===== Begin 範例結構參考.txt =====

﻿# 完整三層結構高階腳本：FastAPI 服務整合 GitHub API 與 OpenAI GPT API
# 三層架構：main.py → analyzer.py → brain.py


# 檔案結構
# ======================
# project_root/
# ├── app/
# │   ├── main.py
# │   ├── analyzer.py
# │   └── brain.py
# ├── requirements.txt
# ├── Dockerfile
# ├── .github/
# │   └── workflows/
# │       └── ci.yml
# └── ai_service_metadata.txt  # 說明與環境變數配置


========================================================================
🔧 app/main.py：系統入口與流程控制中樞
========================================================================
# 核心職責：
# - 啟動 FastAPI 應用
# - 定義所有 API 路由（如 /github/repositories, /github/issue, /gpt/chat）
# - 驗證輸入資料是否正確（使用 Pydantic）
# - 呼叫 analyzer.py 提供的分析函式並回傳結果
# - 負責中繼資料與 context 注入（如 request_id, user_id）


===== app/main.py =====
import os
from fastapi import FastAPI, HTTPException, Depends, Header
from pydantic import BaseModel
from typing import List, Dict, Any
from dotenv import load_dotenv


from app.analyzer import (
    list_user_repos as analyze_list_user_repos,
    create_issue as analyze_create_issue,
    chat_with_gpt as analyze_chat_with_gpt
)


load_dotenv()  # 讀取 .env


app = FastAPI(
    title="高階 GitHub + GPT 服務（三層架構）",
    version="1.0.0",
    description="三層架構：main.py → analyzer.py → brain.py，整合 GitHub API 與 OpenAI GPT API"
)


# 環境變數驗證
GITHUB_TOKEN = os.getenv("GITHUB_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
if not GITHUB_TOKEN:
    raise RuntimeError("缺少 GITHUB_TOKEN 環境變數")
if not OPENAI_API_KEY:
    raise RuntimeError("缺少 OPENAI_API_KEY 環境變數")


# Pydantic Schema 定義
class Repo(BaseModel):
    name: str
    html_url: str
    description: str = None


class IssueRequest(BaseModel):
    owner: str
    repo: str
    title: str
    body: str


class IssueResponse(BaseModel):
    url: str
    title: str
    body: str


class GPTRequest(BaseModel):
    prompt: str
    model: str = "gpt-4o-mini"


class GPTResponse(BaseModel):
    role: str
    content: str


# Routes 定義
@app.get("/github/repositories/{username}", response_model=List[Repo])
async def list_user_repos(
    username: str,
    request_id: str = Header(None),
):
    """
    取得指定使用者的公開 repositories 列表
    main.py 負責驗證並呼叫 analyzer.list_user_repos
    """
    try:
        repos = await analyze_list_user_repos(username=username, request_id=request_id)
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    if repos is None:
        raise HTTPException(status_code=404, detail="查無此使用者或 GitHub API 錯誤")
    return repos


@app.post("/github/issue", response_model=IssueResponse)
async def create_github_issue(
    issue_req: IssueRequest,
    request_id: str = Header(None),
):
    """
    在指定 repository 建立新的 issue
    main.py 呼叫 analyzer.create_issue，回傳結果
    """
    try:
        issue = await analyze_create_issue(
            owner=issue_req.owner,
            repo=issue_req.repo,
            title=issue_req.title,
            body=issue_req.body,
            request_id=request_id
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    if issue is None:
        raise HTTPException(status_code=400, detail="建立 Issue 失敗")
    return issue


@app.post("/gpt/chat", response_model=GPTResponse)
async def chat_with_gpt(
    gpt_req: GPTRequest,
    request_id: str = Header(None),
):
    """
    使用 GPT 生成回應
    main.py 呼叫 analyzer.chat_with_gpt，回傳結果
    """
    try:
        gpt_res = await analyze_chat_with_gpt(
            prompt=gpt_req.prompt,
            model=gpt_req.model,
            request_id=request_id
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    return gpt_res


========================================================================
🔧 app/analyzer.py：模組調度與結果合併層
========================================================================
# 核心職責：
# - 接收 main.py 傳來的請求與 context（request_id 等）
# - 進行參數檢查（可再補充）
# - 調度不同功能模組（代表不同 external API 操作），並統一回傳格式
# - 可以在此層新增或移除模組（如新增更多 GitHub 功能、更多 GPT 操作）


===== app/analyzer.py =====
import os
from typing import List, Dict, Any, Optional
from datetime import datetime


from pydantic import BaseModel


from app.brain import GitHubClient, OpenAIClient


# Pydantic Schema 可複用 main.py 中的定義，或另行定義
class Repo(BaseModel):
    name: str
    html_url: str
    description: str = None


class IssueResponse(BaseModel):
    url: str
    title: str
    body: str


class GPTResponse(BaseModel):
    role: str
    content: str


# 初始化 client（也可改為依賴注入模式）
GITHUB_TOKEN = os.getenv("GITHUB_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")


github_client = GitHubClient(token=GITHUB_TOKEN)
openai_client = OpenAIClient(api_key=OPENAI_API_KEY)


async def list_user_repos(username: str, request_id: Optional[str] = "N/A") -> Optional[List[Repo]]:
    """
    調度 GitHubClient.list_repos，並將回傳結果轉為 Pydantic Model
    """
    # 參數檢查範例
    if not username:
        raise ValueError("username 不可為空")
    # call brain 層
    raw_repos = await github_client.list_repos(username=username, request_id=request_id)
    if raw_repos is None:
        return None
    # 回傳可序列化的 List[Repo]
    return [Repo(name=r.get("name"), html_url=r.get("html_url"), description=r.get("description")) for r in raw_repos]


async def create_issue(owner: str, repo: str, title: str, body: str, request_id: Optional[str] = "N/A") -> Optional[IssueResponse]:
    """
    調度 GitHubClient.create_issue，並包裝成 IssueResponse
    """
    # 參數檢查
    if not all([owner, repo, title]):
        raise ValueError("owner, repo, title 欄位不可為空")
    issue = await github_client.create_issue(owner=owner, repo=repo, title=title, body=body, request_id=request_id)
    if issue is None:
        return None
    return IssueResponse(url=issue.get("html_url"), title=issue.get("title"), body=issue.get("body"))


async def chat_with_gpt(prompt: str, model: str = "gpt-4o-mini", request_id: Optional[str] = "N/A") -> GPTResponse:
    """
    調度 OpenAIClient.generate_response，並回傳 GPTResponse
    """
    if not prompt:
        raise ValueError("prompt 不可為空")
    raw = await openai_client.generate_response(prompt=prompt, model=model, request_id=request_id)
    return GPTResponse(role=raw.get("role"), content=raw.get("content"))


========================================================================
🔧 app/brain.py：AI 模組邏輯實作層
========================================================================
# 核心職責：
# - 各模組最底層的邏輯與外部 API 呼叫
# - GitHubClient 負責所有 GitHub REST API 呼叫細節
# - OpenAIClient 負責所有 OpenAI GPT API 呼叫細節
# - 這層可以根據需求新增更多模組方法（如其他 GitHub 功能、文件分析、資料庫存取等）


===== app/brain.py =====
import os
import httpx
import openai
from typing import Any, Dict, List, Optional


# GitHub API
GITHUB_API_BASE_URL = "https://api.github.com"


class GitHubClient:
    def __init__(self, token: str):
        self.token = token
        self.headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/vnd.github.v3+json"
        }


    async def list_repos(self, username: str, request_id: Optional[str] = "N/A") -> Optional[List[Dict[str, Any]]]:
        """
        在最底層呼叫 GitHub API 取得公開 repos
        """
        url = f"{GITHUB_API_BASE_URL}/users/{username}/repos"
        # 可以把 request_id 用於日誌或追蹤
        async with httpx.AsyncClient() as client:
            response = await client.get(url, headers=self.headers)
            if response.status_code == 200:
                return response.json()
            else:
                # 可以在此層做錯誤日誌（尚未實作）
                return None


    async def create_issue(self, owner: str, repo: str, title: str, body: str, request_id: Optional[str] = "N/A") -> Optional[Dict[str, Any]]:
        """
        在最底層呼叫 GitHub API 建立 issue
        """
        url = f"{GITHUB_API_BASE_URL}/repos/{owner}/{repo}/issues"
        payload = {"title": title, "body": body}
        async with httpx.AsyncClient() as client:
            response = await client.post(url, json=payload, headers=self.headers)
            if response.status_code == 201:
                return response.json()
            else:
                return None


# OpenAI GPT API
class OpenAIClient:
    def __init__(self, api_key: str):
        openai.api_key = api_key


    async def generate_response(self, prompt: str, model: str = "gpt-4o-mini", request_id: Optional[str] = "N/A") -> Dict[str, Any]:
        """
        在最底層呼叫 OpenAI ChatCompletion，返回 GPT 回應
        """
        response = await openai.ChatCompletion.acreate(
            model=model,
            messages=[
                {"role": "system", "content": "You are a helpful assistant."},
                {"role": "user", "content": prompt}
            ],
            max_tokens=800,
            n=1,
            temperature=0.7
        )
        choice = response.choices[0].message
        return {"role": choice["role"], "content": choice["content"]}


