{
  "concepts": [
    {
      "id": 1,
      "term": "Grid Representation",
      "category": "Matrix Operations",
      "subcategory": "Grid Representation",
      "definition": "以二維陣列表示刮刮樂盤面。Represents the scratch-card board as a two-dimensional array.",
      "example": "[[12, -1, 30], [5,  8, -1]]"
    },
    {
      "id": 2,
      "term": "Coordinate System",
      "category": "Discrete Mathematics",
      "subcategory": "Coordinate Geometry",
      "definition": "以 (row, col) 定位每個格子。Uses (row, col) to locate each cell in the grid.",
      "example": "(3, 5)"
    },
    {
      "id": 3,
      "term": "Set Difference",
      "category": "Set Theory",
      "subcategory": "Set Operations",
      "definition": "從全集移除已開數字，得出剩餘可補數字。Computes the remaining numbers by subtracting opened values from the universal set.",
      "example": "{1..40} \\ {opened_numbers}"
    },
    {
      "id": 4,
      "term": "Arithmetic Progression",
      "category": "Number Theory",
      "subcategory": "Sequences",
      "definition": "等差數列：由首項與公差決定的序列。A sequence defined by its first term and common difference.",
      "example": "a_n = a_1 + (n−1)·d"
    },
    {
      "id": 5,
      "term": "Geometric Progression",
      "category": "Number Theory",
      "subcategory": "Sequences",
      "definition": "等比數列：由首項與公比決定的序列。A sequence defined by its first term and common ratio.",
      "example": "a_n = a_1 · r^(n−1)"
    },
    {
      "id": 6,
      "term": "Difference Analysis",
      "category": "Algorithms",
      "subcategory": "Sequence Analysis",
      "definition": "計算相鄰元素差值序列。Computes the differences between adjacent elements.",
      "example": "diff[i] = arr[i+1] − arr[i]"
    },
    {
      "id": 7,
      "term": "Sliding Window",
      "category": "Algorithms",
      "subcategory": "Windowing",
      "definition": "在序列上滑動固定長度窗口進行分析。Analyzes a sequence by sliding a fixed-length window.",
      "example": "sum(arr[t:t+k])"
    },
    {
      "id": 8,
      "term": "Convolution",
      "category": "Algorithms",
      "subcategory": "Signal Processing",
      "definition": "對序列或矩陣進行捲積運算。Performs convolution over sequences or matrices.",
      "example": "(f * g)[n] = Σ_k f[k]·g[n−k]"
    },
    {
      "id": 9,
      "term": "Mirror Symmetry",
      "category": "Discrete Mathematics",
      "subcategory": "Symmetry Detection",
      "definition": "檢測行或列的鏡像對稱性。Detects mirror symmetry along rows or columns.",
      "example": "grid[i][j] == grid[i][N-1-j]"
    },
    {
      "id": 10,
      "term": "Block Heatmap",
      "category": "Statistics",
      "subcategory": "Local Analysis",
      "definition": "基於區塊內均值偏差生成熱力圖。Heatmap based on local block mean deviations.",
      "example": "block_mean = mean(block)"
    },
    {
      "id": 11,
      "term": "Global Heatmap",
      "category": "Statistics",
      "subcategory": "Global Analysis",
      "definition": "對整盤格子計算熱力分數。Scores each cell to create a heatmap of the entire board.",
      "example": "score[i][j] = f(grid[i][j])"
    },
    {
      "id": 12,
      "term": "Dynamic Threshold",
      "category": "Statistics",
      "subcategory": "Thresholding",
      "definition": "根據資料分佈動態調整閾值。Adjusts thresholds dynamically based on data distribution.",
      "example": "threshold = μ + k·σ"
    },
    {
      "id": 13,
      "term": "Connectivity Graph",
      "category": "Graph Theory",
      "subcategory": "Grid Graphs",
      "definition": "將格子視為節點並檢測相鄰連通性。Treats cells as nodes and detects adjacency connectivity.",
      "example": "edges connect (i,j) and (i+1,j)"
    },
    {
      "id": 14,
      "term": "Probability Distribution",
      "category": "Probability & Statistics",
      "subcategory": "Discrete Distribution",
      "definition": "離散隨機變量的分佈。Distribution of a discrete random variable.",
      "example": "P(X=k) = 1/N"
    },
    {
      "id": 15,
      "term": "Confidence Score",
      "category": "Statistics",
      "subcategory": "Scoring",
      "definition": "為預測結果分配信心水準。Assigns confidence levels to prediction results.",
      "example": "conf = Σ (w_i * s_i)"
    },
    {
      "id": 16,
      "term": "Mean",
      "category": "Probability & Statistics",
      "subcategory": "Descriptive Statistics",
      "definition": "所有值的算術平均。Arithmetic average of all values.",
      "example": "μ = Σ x_i / n"
    },
    {
      "id": 17,
      "term": "Variance",
      "category": "Probability & Statistics",
      "subcategory": "Descriptive Statistics",
      "definition": "資料點偏離平均值的平方平均。Average of squared deviations from the mean.",
      "example": "σ² = Σ (x_i - μ)² / n"
    },
    {
      "id": 18,
      "term": "Standard Deviation",
      "category": "Probability & Statistics",
      "subcategory": "Descriptive Statistics",
      "definition": "資料分佈的平均離差。Square root of the variance.",
      "example": "σ = √σ²"
    },
    {
      "id": 19,
      "term": "Z-Score",
      "category": "Probability & Statistics",
      "subcategory": "Normalization",
      "definition": "表示資料點與平均值的標準差距。Number of standard deviations a data point is from the mean.",
      "example": "z = (x - μ) / σ"
    },
    {
      "id": 20,
      "term": "Set Cardinality",
      "category": "Set Theory",
      "subcategory": "Set Properties",
      "definition": "集合中元素的數目。Number of elements in a set.",
      "example": "|{1,2,3}| = 3"
    }
  ]
}