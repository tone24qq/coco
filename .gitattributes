# Normalize text files to LF and avoid accidental binary diffs for source/docs/config.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
*.gitattributes text eol=lf
*.gitignore text diff eol=lf
.gitignore text diff eol=lf
